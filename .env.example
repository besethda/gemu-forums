# Copy to .env.local and fill in from Supabase: Project Settings → API Keys / Data API.

# Project URL, e.g. https://abcdefghijklmnop.supabase.co
NEXT_PUBLIC_SUPABASE_URL=

# Publishable key (sb_publishable_…) or the legacy anon key. Safe to expose to
# the browser — row level security policies decide what it can read and write.
NEXT_PUBLIC_SUPABASE_PUBLISHABLE_KEY=

# Project ref (the subdomain of the URL). Only used by `npm run db:types`.
SUPABASE_PROJECT_ID=

# Secret key (sb_secret_…). Server only — never prefix with NEXT_PUBLIC_.
# Used to generate submission sign-in links.
SUPABASE_SECRET_KEY=

# EmailJS (same service and template as the newsletter). The template must
# use {{to_email}}, {{subject}} and {{message}}.
NEXT_PUBLIC_EMAILJS_SERVICE_ID=
NEXT_PUBLIC_EMAILJS_TEMPLATE_ID=
NEXT_PUBLIC_EMAILJS_PUBLIC_KEY=
# Private key from EmailJS → Account → Security, with "Allow EmailJS API for
# non-browser applications" switched on. Server only.
EMAILJS_PRIVATE_KEY=
