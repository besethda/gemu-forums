# Copy to .env.local and fill in from Supabase: Project Settings → API Keys / Data API.

# Project URL, e.g. https://abcdefghijklmnop.supabase.co
NEXT_PUBLIC_SUPABASE_URL=

# Publishable key (sb_publishable_…) or the legacy anon key. Safe to expose to
# the browser — row level security policies decide what it can read and write.
NEXT_PUBLIC_SUPABASE_PUBLISHABLE_KEY=

# Project ref (the subdomain of the URL). Only used by `npm run db:types`.
SUPABASE_PROJECT_ID=
